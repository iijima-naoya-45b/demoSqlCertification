# 実行モード: docker | local
DB_MODE=docker

# アプリケーション接続情報
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sql_certification
POSTGRES_USER=sqluser
POSTGRES_PASSWORD=sqlpass

# ローカルセットアップ時の管理者接続情報
# macOS (Homebrew) では POSTGRES_ADMIN_USER に OS ユーザー名を指定するのが一般的です
# 例: POSTGRES_ADMIN_USER=naoyaiijima
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_ADMIN_HOST=localhost
POSTGRES_ADMIN_PORT=5432
