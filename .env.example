# 実行モード: docker | local
DB_MODE=docker

# アプリケーション接続情報
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sql_certification
POSTGRES_USER=sqluser
POSTGRES_PASSWORD=sqlpass

# ローカルセットアップ時の管理者接続情報
# macOS (Homebrew) では POSTGRES_ADMIN_USER に OS ユーザー名を指定するのが一般的です
# 例: POSTGRES_ADMIN_USER=naoyaiijima
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_ADMIN_HOST=localhost
POSTGRES_ADMIN_PORT=5432

# Google ログイン（Keycloak 外部 IdP 連携）
# Google Cloud Console で OAuth 2.0 クライアントを作成し、以下を設定してください。
# リダイレクト URI: http://localhost:8180/realms/demo-shop/broker/google/endpoint
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# APP_AUTH_GOOGLE_LOGIN_ENABLED=true
